{
  "name": "dotquilt-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24.15"
  },
  "workspaces": [
    "packages/*",
    "apps/site",
    "examples/next",
    "examples/nuxt",
    "examples/sveltekit",
    "examples/angular"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check && tsc --noEmit -p tsconfig.json",
    "lint": "biome check packages apps/site scripts tests examples package.json turbo.json tsconfig.json biome.json playwright*.config.ts .changeset --error-on-warnings",
    "format": "biome check --write packages apps/site scripts tests examples package.json turbo.json tsconfig.json biome.json playwright*.config.ts .changeset",
    "test": "turbo run test && bun test scripts tests/layout/score",
    "test:e2e": "playwright test",
    "test:e2e:all": "ALL_BROWSERS=1 playwright test",
    "test:legacy": "bun run scripts/test-legacy.ts",
    "size": "bun run scripts/size.ts",
    "verify": "bun run lint && bun run check && bun run test && bun run build && bun run size && bun run test:e2e",
    "verify:packed": "bun run scripts/verify-packed.ts",
    "changeset": "changeset",
    "release:check": "bun run scripts/release-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "custom-elements-manifest": "2.1.0",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "typescript-min": "npm:typescript@5.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotquilt": "workspace:*",
    "@dotquilt/react": "workspace:*",
    "@dotquilt/vue": "workspace:*",
    "vue": "3.5.46",
    "@dotquilt/svelte": "workspace:*",
    "svelte": "5.59.1",
    "@dotquilt/angular": "workspace:*"
  }
}
