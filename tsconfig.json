{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": false,
    "types": ["bun"],
    "jsx": "react-jsx"
  },
  "include": [
    "packages/core/meta/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "playwright*.config.ts",
    "tests/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx"
  ],
  "exclude": [
    "tests/types",
    "examples/next",
    "examples/nuxt",
    "examples/sveltekit"
  ]
}
