{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "scripts/**",
      "tests/**",
      "examples/**",
      "apps/site/**",
      "!**/dist",
      "!**/.astro",
      "!**/.impeccable/hook.cache.json",
      "*.json",
      "playwright*.config.ts",
      ".changeset/*.json",
      "!**/.next",
      "!**/next-env.d.ts",
      "!examples/next/tsconfig.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
