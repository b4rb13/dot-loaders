---
/**
 * The playground: every option of every loader, a live stage that loads
 * from a simulated request, and the React, HTML and CSS for the result. The
 * settings live in the URL, so any setup can be shared as a link.
 */
import Demo from '../examples/Demo.astro';
import type { Recipe } from '../examples/recipes';
import {
  components,
  defaults,
  marks,
  palettes,
  ranges,
  variants,
} from './settings';

const base = (
  demo: Recipe['demo'],
  family: Recipe['family'],
  variant?: Recipe['variant'],
): Recipe => ({
  id: `stage-${demo}-${variant ?? ''}`,
  family,
  demo,
  title: '',
  text: '',
  delay: defaults.delay,
  ...(variant && { variant }),
});
const stages: { component: string; variant?: string; recipe: Recipe }[] = [
  { component: 'skeleton', recipe: base('article', 'skeleton') },
  { component: 'text', recipe: base('kpi', 'text') },
  ...variants.map(([variant]) => ({
    component: 'chart',
    variant,
    recipe: base('chart', 'chart', variant),
  })),
  { component: 'table', recipe: base('invoices', 'table') },
  { component: 'typing', recipe: base('reply', 'typing') },
];
const slider = (key: keyof typeof ranges) => ranges[key];
---

<div class="playground not-content" data-playground>
  <form class="controls home-card" aria-label="Settings" data-controls>
    <fieldset>
      <legend>Component</legend>
      <div class="choices">
        {
          components.map(([value, label]) => (
            <label>
              <input type="radio" name="component" value={value} checked={value === defaults.component} />
              <span>{label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend>Mark</legend>
      <div class="choices">
        {
          marks.map(([value, label]) => (
            <label>
              <input type="radio" name="mark" value={value} checked={value === defaults.mark} />
              <span>
                <i class:list={['mark-glyph', value]} aria-hidden="true" />
                {label}
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset data-only="chart">
      <legend>Chart</legend>
      <div class="choices">
        {
          variants.map(([value, label]) => (
            <label>
              <input type="radio" name="variant" value={value} checked={value === defaults.variant} />
              <span>{label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend>While loading</legend>
      <div class="choices" data-options="idle"></div>
    </fieldset>

    <fieldset>
      <legend>When it arrives</legend>
      <div class="choices" data-options="handoff"></div>
    </fieldset>

    <fieldset>
      <legend>Colour</legend>
      <div class="swatches">
        {
          palettes.map((palette) => (
            <label title={palette.name}>
              <input
                type="radio"
                name="palette"
                value={palette.id}
                checked={palette.id === defaults.palette}
                aria-label={palette.name}
              />
              <span style={`--swatch:${palette.swatch}`} />
            </label>
          ))
        }
      </div>
    </fieldset>

    <label class="range" data-dots-only>
      <span>Dot size <output name="size-out">{defaults.size} px</output></span>
      <input type="range" name="size" {...slider('size')} value={defaults.size} />
    </label>
    <label class="range" data-dots-only>
      <span>Spacing <output name="gap-out">{defaults.gap} px</output></span>
      <input type="range" name="gap" {...slider('gap')} value={defaults.gap} />
    </label>
    <p class="hint" data-fixed-hint hidden>Squares and dashes have a fixed size and spacing.</p>
    <label class="range">
      <span>Pace <output name="speed-out">{defaults.speed}×</output></span>
      <input type="range" name="speed" {...slider('speed')} value={defaults.speed} />
    </label>
    <label class="range">
      <span>Request time <output name="delay-out">{defaults.delay / 1000} s</output></span>
      <input type="range" name="delay" {...slider('delay')} value={defaults.delay} />
    </label>
    <button type="button" class="reset" data-reset>Reset to defaults</button>
  </form>

  <div class="main">
    <section class="stage-card home-card" aria-label="Live preview">
      <div class="bar">
        <span class="status" role="status" data-status>Loading</span>
        <div class="bar-actions">
          <button type="button" class="home-button small" data-start>Start loading</button>
          <button type="button" class="home-button small primary" data-reveal>Reveal</button>
        </div>
      </div>
      <div class="stage" data-stage>
        {
          stages.map((stage) => (
            <div
              class="demo"
              data-demo={stage.component}
              data-variant={stage.variant}
              hidden={stage.component !== defaults.component || (stage.variant !== undefined && stage.variant !== defaults.variant)}
            >
              <Demo recipe={stage.recipe} />
            </div>
          ))
        }
      </div>
    </section>

    <section class="code-card" aria-label="Code">
      <div class="code-bar">
        <div class="tabs" role="tablist" aria-label="Code">
          <button type="button" role="tab" aria-selected="true" aria-controls="code-panel" data-tab="react">React</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="code-panel" data-tab="html">HTML</button>
          <button type="button" role="tab" aria-selected="false" aria-controls="code-panel" data-tab="css">CSS</button>
        </div>
        <div class="code-actions">
          <button type="button" class="ghost" data-copy-link>Copy link</button>
          <button type="button" class="ghost" data-copy-code>Copy code</button>
        </div>
      </div>
      <pre id="code-panel" role="tabpanel" tabindex="0"><code data-code-out></code></pre>
    </section>
  </div>
</div>

<script>
  import { refreshStyles } from '@dotquilt-internal/core';
  import { registerAll } from '@dotquilt-internal/core/register-all';
  import { animate, load, loaderSelector, wire } from '../examples/live';
  import { htmlCode, reactCode } from '../examples/recipes';
  import {
    type Component,
    css,
    defaults,
    handoffs,
    idles,
    palettes,
    parse,
    recipe,
    type Settings,
    serialize,
  } from './settings';

  registerAll();
  const root = document.querySelector<HTMLElement>('[data-playground]');
  const form = root?.querySelector<HTMLFormElement>('[data-controls]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');
  const out = root?.querySelector<HTMLElement>('[data-code-out]');

  if (root && form && stage && out) {
    let settings: Settings = parse(location.search);
    let tab: 'react' | 'html' | 'css' = 'react';
    let request: ReturnType<typeof load> | null = null;
    wire(stage);

    const field = (name: string) =>
      form.elements.namedItem(name) as RadioNodeList | HTMLInputElement | null;

    /** The idle and handoff choices for the current component. */
    function options(kind: 'idle' | 'handoff', component: Component) {
      const box = form?.querySelector<HTMLElement>(`[data-options="${kind}"]`);
      if (!box) return;
      const list = (kind === 'idle' ? idles : handoffs)[component];
      box.replaceChildren(
        ...list.map(([value, label]) => {
          const option = document.createElement('label');
          const input = document.createElement('input');
          input.type = 'radio';
          input.name = kind;
          input.value = value;
          input.checked = settings[kind] === value;
          const text = document.createElement('span');
          text.textContent = label;
          option.append(input, text);
          return option;
        }),
      );
      box.closest('fieldset')?.toggleAttribute('data-single', list.length < 2);
    }

    /** The form shows `settings`. */
    function show() {
      for (const name of ['component', 'mark', 'variant', 'palette'] as const) {
        const control = field(name);
        if (control && 'value' in control) control.value = settings[name];
      }
      options('idle', settings.component);
      options('handoff', settings.component);
      for (const name of ['size', 'gap', 'speed', 'delay'] as const) {
        const input = field(name) as HTMLInputElement | null;
        if (input) input.value = String(settings[name]);
      }
      const label = (name: string, text: string) => {
        const output = form?.querySelector<HTMLOutputElement>(`output[name="${name}-out"]`);
        if (output) output.value = text;
      };
      label('size', `${settings.size} px`);
      label('gap', `${settings.gap} px`);
      label('speed', `${settings.speed}×`);
      label('delay', `${settings.delay / 1000} s`);
      for (const only of form?.querySelectorAll<HTMLElement>('[data-only]') ?? [])
        only.hidden = only.dataset.only !== settings.component;
      const dots = settings.mark === 'dot';
      for (const range of form?.querySelectorAll<HTMLElement>('[data-dots-only]') ?? [])
        range.hidden = !dots;
      form?.querySelector('[data-fixed-hint]')?.toggleAttribute('hidden', dots);
    }

    /** The stage and the code follow `settings`. */
    function apply() {
      if (!stage || !out) return;
      for (const demo of stage.querySelectorAll<HTMLElement>('[data-demo]'))
        demo.hidden =
          demo.dataset.demo !== settings.component ||
          (demo.dataset.variant !== undefined && demo.dataset.variant !== settings.variant);
      const palette = palettes.find((entry) => entry.id === settings.palette);
      const style = stage.style;
      const set = (name: string, value: string | false | undefined) =>
        value ? style.setProperty(name, value) : style.removeProperty(name);
      set('--dotquilt-color', palette?.mark);
      set('--dotquilt-accent-color', palette?.glow);
      set('--dotquilt-dot-size', `${settings.size}px`);
      set('--dotquilt-dot-gap', `${settings.gap}px`);
      for (const loader of stage.querySelectorAll(loaderSelector)) {
        if (settings.mark === 'dot') loader.removeAttribute('mark');
        else loader.setAttribute('mark', settings.mark);
        if (settings.speed === 1) loader.removeAttribute('speed');
        else loader.setAttribute('speed', String(settings.speed));
      }
      animate(stage, settings.idle, settings.handoff);
      // Canvas loaders read new colours on request.
      refreshStyles(stage);
      write();
      history.replaceState(null, '', `?${serialize(settings)}`);
      start();
    }

    function write() {
      if (!out) return;
      const current = recipe(settings);
      out.textContent =
        tab === 'react'
          ? reactCode(current)
          : tab === 'html'
            ? htmlCode(current)
            : (css(settings) ?? '/* The default colours and sizes: nothing to add. */');
    }

    const status = root.querySelector<HTMLElement>('[data-status]');
    /** A fresh request for the visible demo. */
    function start() {
      const demo = stage?.querySelector<HTMLElement>('[data-demo]:not([hidden])');
      if (!demo) return;
      request?.settle();
      request = load(demo, settings.delay);
      if (status) status.textContent = 'Loading';
      const mine = request;
      mine.done.then(() => {
        if (request === mine && status) status.textContent = 'Loaded';
      });
    }

    form.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      const name = input.name as keyof Settings;
      if (!(name in defaults)) return;
      const value = typeof defaults[name] === 'number' ? Number(input.value) : input.value;
      settings = { ...settings, [name]: value };
      // A new component starts from its own default animations.
      if (name === 'component') settings = { ...settings, idle: '', handoff: '' };
      show();
      apply();
    });
    // Sliders show their value while dragging; the stage follows on release.
    form.addEventListener('input', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.type !== 'range') return;
      const output = form.querySelector<HTMLOutputElement>(`output[name="${input.name}-out"]`);
      if (!output) return;
      const value = Number(input.value);
      output.value =
        input.name === 'speed' ? `${value}×` : input.name === 'delay' ? `${value / 1000} s` : `${value} px`;
    });
    form.querySelector('[data-reset]')?.addEventListener('click', () => {
      settings = { ...defaults };
      show();
      apply();
    });
    root.querySelector('[data-start]')?.addEventListener('click', start);
    root.querySelector('[data-reveal]')?.addEventListener('click', () => request?.settle());

    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    for (const button of tabs)
      button.addEventListener('click', () => {
        tab = (button.dataset.tab as typeof tab) ?? 'react';
        for (const other of tabs) other.setAttribute('aria-selected', String(other === button));
        write();
      });

    async function copy(button: HTMLButtonElement, text: string, label: string) {
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
      }
      setTimeout(() => {
        button.textContent = label;
      }, 1600);
    }
    root.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click', (event) =>
      copy(event.currentTarget as HTMLButtonElement, location.href, 'Copy link'),
    );
    root.querySelector<HTMLButtonElement>('[data-copy-code]')?.addEventListener('click', (event) =>
      copy(event.currentTarget as HTMLButtonElement, out.textContent ?? '', 'Copy code'),
    );

    show();
    apply();
  }
</script>

<style>
  .playground {
    display: grid;
    grid-template-columns: 19rem minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    margin-top: 1rem;
  }
  .controls {
    position: sticky;
    top: calc(var(--sl-nav-height, 4rem) + 1rem);
    display: grid;
    gap: 1.125rem;
    padding: 1.25rem;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  fieldset[hidden],
  fieldset[data-single],
  .range[hidden] {
    display: none;
  }
  legend,
  .range > span {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--dq-ink);
  }
  output {
    font-weight: 500;
    color: var(--dq-muted);
    font-variant-numeric: tabular-nums;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .choices :global(label),
  .swatches label {
    position: relative;
    cursor: pointer;
  }
  /* The radios stay in the page for the keyboard and screen readers. The
     animation choices are built by the script, so their rules are global. */
  .controls :global(input[type='radio']) {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .choices :global(span) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 11px;
    border: 1px solid var(--dq-line);
    border-radius: var(--dq-radius-sm);
    background: var(--dq-surface);
    color: var(--dq-muted);
    font-size: 0.8125rem;
    font-weight: 500;
    transition:
      background var(--dq-duration-ui) var(--dq-ease-settle),
      color var(--dq-duration-ui) var(--dq-ease-settle);
  }
  .choices :global(label:hover span) {
    color: var(--dq-ink);
  }
  .choices :global(input:checked + span) {
    border-color: var(--dq-ink);
    background: var(--dq-ink);
    color: var(--dq-surface);
  }
  .choices :global(input:focus-visible + span),
  .swatches input:focus-visible + span {
    outline: 2px solid var(--dq-accent);
    outline-offset: 2px;
  }
  .swatches {
    display: flex;
    gap: 8px;
  }
  .swatches span {
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 2px var(--dq-surface);
    border: 2px solid transparent;
  }
  .swatches input:checked + span {
    border-color: var(--dq-ink);
  }
  .range {
    display: grid;
  }
  .range input {
    width: 100%;
    accent-color: var(--dq-accent);
  }
  .hint {
    margin: -0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--dq-muted);
  }
  .reset {
    justify-self: start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--dq-muted);
    font: 500 0.8125rem / 1.4 var(--dq-font);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .reset:hover {
    color: var(--dq-ink);
  }
  .main {
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  .stage-card {
    overflow: hidden;
  }
  .bar,
  .code-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .bar {
    padding: 12px 14px 12px 20px;
    border-bottom: 1px solid var(--dq-line);
  }
  .status {
    font-size: 0.8125rem;
    color: var(--dq-muted);
  }
  .bar-actions {
    display: flex;
    gap: 8px;
  }
  .stage {
    display: grid;
    place-items: center;
    min-height: 22rem;
    padding: 2.5rem 2rem;
  }
  .demo {
    width: min(100%, 30rem);
  }
  .demo[hidden] {
    display: none;
  }
  .code-card {
    border-radius: var(--dq-radius-md);
    background: var(--dq-code-bg);
    color: var(--dq-code-fg);
    overflow: hidden;
  }
  .code-bar {
    padding: 8px 10px 8px 8px;
    border-bottom: 1px solid color-mix(in srgb, var(--dq-code-fg) 12%, transparent);
  }
  .tabs {
    display: flex;
    gap: 2px;
  }
  .tabs button,
  .ghost {
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--dq-radius-sm);
    background: transparent;
    color: var(--dq-code-punct);
    font: 500 0.8125rem / 1 var(--dq-font);
    cursor: pointer;
  }
  .tabs button[aria-selected='true'] {
    background: color-mix(in srgb, var(--dq-code-fg) 10%, transparent);
    color: var(--dq-code-fg);
  }
  .ghost:hover,
  .tabs button:hover {
    color: var(--dq-code-fg);
  }
  .tabs button:focus-visible,
  .ghost:focus-visible,
  .reset:focus-visible,
  pre:focus-visible {
    outline: 2px solid var(--dq-accent);
    outline-offset: 2px;
  }
  pre {
    margin: 0;
    padding: 1.25rem 1.375rem;
    min-height: 14rem;
    overflow-x: auto;
    background: none;
    border: 0;
    font: 0.8125rem / 1.65 var(--dq-font-mono);
  }
  pre code {
    background: none;
    padding: 0;
    color: inherit;
    font: inherit;
  }
  @media (max-width: 56rem) {
    /* On narrow screens the preview comes first, then the settings, then
       the code. */
    .playground {
      grid-template-columns: minmax(0, 1fr);
    }
    .main {
      display: contents;
    }
    .stage-card {
      order: -1;
    }
    .code-card {
      order: 1;
    }
    .controls {
      position: static;
    }
    .stage {
      min-height: 16rem;
      padding: 1.75rem 1.25rem;
    }
  }
</style>
