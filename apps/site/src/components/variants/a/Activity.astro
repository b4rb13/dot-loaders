---
/**
 * An activity feed. It loads once from its placeholder; after that, Refresh
 * keeps every item readable under the region's thread of marks, and the new
 * items settle in at the top.
 */
import { activity } from './data';
---

<section class="va va-section home-section not-content va-split" aria-labelledby="va-activity-title" data-va-activity>
  <div class="va-head">
    <h2 id="va-activity-title">Refreshing never moves the page.</h2>
    <p>
      Press Refresh. While the update loads, one row of marks rests just above
      the feed and the glow passes along it once. Nothing below it moves or
      hides, so the feed stays readable the whole time.
    </p>
    <p class="va-uses">
      dotquilt-region state="refreshing"
    </p>
  </div>

  <div class="va-frame va-feed" role="group" aria-label="Example activity feed">
    <div class="va-frame-bar">
      <p class="va-frame-title"><span class="va-workspace" aria-hidden="true">F</span>Activity</p>
      <button type="button" class="home-button small" data-refresh>Refresh</button>
    </div>
    <div class="va-feed-body">
      <dotquilt-region aria-label="Activity" data-feed-region>
        <div slot="placeholder" class="va-feed-list">
          {
            activity.map((item) => (
              <div class="va-feed-item">
                <dotquilt-skeleton-circle></dotquilt-skeleton-circle>
                <span class="text">
                  <dotquilt-skeleton-line style={`width: ${item.text.length * 0.9}ch`}></dotquilt-skeleton-line>
                  <dotquilt-skeleton-line style={`width: ${item.time.length * 0.85}ch`}></dotquilt-skeleton-line>
                </span>
              </div>
            ))
          }
        </div>
        <ul class="va-feed-list" data-feed>
          {
            activity.map((item) => (
              <li class="va-feed-item">
                <span class="va-avatar">{item.initials}</span>
                <span class="text">
                  <span class="what">{item.text}</span>
                  <time>{item.time}</time>
                </span>
              </li>
            ))
          }
        </ul>
      </dotquilt-region>
    </div>
    <div class="va-frame-foot">
      <span><span class="va-caption">Example data.</span> <span role="status" data-status>Up to date.</span></span>
    </div>
  </div>
</section>

<script>
  import { startActivity } from './activity';

  startActivity();
</script>

<style is:global>
  .va-feed-body {
    padding: 1.25rem 1.25rem 1rem;
  }
  .va-feed-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .va-feed-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    margin: 0;
    padding: 0.375rem 0.5rem;
    border-radius: var(--dq-radius-sm);
    font-size: 0.875rem;
  }
  .va-feed-item dotquilt-skeleton-circle {
    width: 2rem;
  }
  .va-feed-item .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    min-width: 0;
  }
  .va-feed-item dotquilt-skeleton-line {
    max-width: 100%;
  }
  .va-feed-item time {
    font-size: 0.75rem;
    color: var(--dq-faint);
  }
  .va-feed-item .what {
    max-width: 100%;
    overflow: hidden;
    color: var(--dq-ink);
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  /* New items settle in at the top and keep a quiet fill for a moment. */
  .va-feed-item[data-new] {
    animation:
      va-row-fade var(--dq-duration-fade) var(--dq-ease-fade) both,
      va-row-rise var(--dq-duration-rise) var(--dq-ease-settle) both,
      va-feed-glow 2.8s var(--dq-ease-fade) both;
    animation-delay: calc(var(--i, 0) * var(--dq-stagger-row));
  }
  @keyframes va-feed-glow {
    from,
    30% {
      background: var(--dq-subtle);
    }
    to {
      background: transparent;
    }
  }
  /* The list grows from the top without a jump: older items glide down. */
  .va-feed-item[data-shift] {
    animation: va-feed-shift var(--dq-duration-rise) var(--dq-ease-settle) both;
  }
  @keyframes va-feed-shift {
    from {
      translate: 0 var(--shift, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .va-feed-item[data-new],
    .va-feed-item[data-shift] {
      animation: none;
    }
  }
</style>
