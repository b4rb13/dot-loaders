---
/**
 * What Dotquilt takes care of, each with its proof in the row: a live
 * loader, the server's own markup, or the line of code that does it. The
 * proofs arrive from marks, row after row, as the list scrolls in.
 */
import { renderStatic } from 'dotquilt/server';

// A placeholder rendered here, on the server, by the library itself.
const serverMarkup = renderStatic({ kind: 'skeleton-text', lines: 2 });
---

<section class="home-section vb-features" aria-labelledby="vb-features-title" data-features>
  <header>
    <h2 id="vb-features-title">The details are already handled.</h2>
    <p>Each claim comes with its proof beside it.</p>
  </header>

  <ul class="rows" role="list">
    <li>
      <h3>Calm by design</h3>
      <p>
        The idle glow drifts for four seconds, then rests. Reveals take about a
        second, on long eased curves, and never snap.
      </p>
      <dotquilt-region class="proof" state="ready" aria-label="Idle proof" data-arrival data-proof>
        <dotquilt-skeleton-line slot="placeholder"></dotquilt-skeleton-line>
        <div class="calm">
          <dotquilt-region state="pending" aria-label="Idle timer example" data-calm>
            <dotquilt-skeleton-line slot="placeholder" data-calm-line></dotquilt-skeleton-line>
            <span></span>
          </dotquilt-region>
          <p class="readout">
            <span role="status" data-calm-status>Resting.</span>
            <button type="button" class="link" data-calm-again>Watch it again</button>
          </p>
        </div>
      </dotquilt-region>
    </li>
    <li>
      <h3>Accessible by default</h3>
      <p>
        Reduced motion stills every loader, and so does a pause. Pending content
        is out of reach of the keyboard and screen readers, focus is kept, and
        high-contrast mode shows a clear outline.
      </p>
      <dotquilt-region class="proof" state="ready" aria-label="Pause proof" data-arrival data-proof>
        <dotquilt-skeleton-line slot="placeholder"></dotquilt-skeleton-line>
        <div class="pause">
          <dotquilt-region state="pending" aria-label="Pause example" data-pausable>
            <dotquilt-skeleton-text slot="placeholder" lines="2"></dotquilt-skeleton-text>
            <span></span>
          </dotquilt-region>
          <button type="button" class="toggle" aria-pressed="false" data-pause>Pause motion</button>
        </div>
      </dotquilt-region>
    </li>
    <li>
      <h3>Rendered on the server</h3>
      <p>
        Placeholders are in the first HTML, in the size of your content, so
        nothing jumps when JavaScript arrives.
      </p>
      <dotquilt-region class="proof" state="ready" aria-label="Server proof" data-arrival data-proof>
        <dotquilt-skeleton-line slot="placeholder"></dotquilt-skeleton-line>
        <div class="server">
          <div class="server-out" set:html={serverMarkup} />
          <details>
            <summary>The HTML this page was sent</summary>
            <pre><code>{serverMarkup.replace(/<style[\s\S]*?<\/style>/g, '<style>…</style>')}</code></pre>
          </details>
        </div>
      </dotquilt-region>
    </li>
    <li>
      <h3>Strict CSP</h3>
      <p>
        No inline style attributes. Allow the stylesheets with a nonce, with
        hashes, or serve them as files.
      </p>
      <dotquilt-region class="proof" state="ready" aria-label="CSP proof" data-arrival data-proof>
        <dotquilt-skeleton-line slot="placeholder"></dotquilt-skeleton-line>
        <pre class="code"><code><span class="k">stylePolicy</span>: {'{'} mode: <span class="s">'external'</span>, href: <span class="s">'/dotquilt.css'</span> {'}'}</code></pre>
      </dotquilt-region>
    </li>
    <li>
      <h3>Any framework</h3>
      <p>
        Native web components work in plain HTML, Vue, Svelte or anywhere else.
        A typed React adapter adds server rendering.
      </p>
      <dotquilt-region class="proof" state="ready" aria-label="Framework proof" data-arrival data-proof>
        <dotquilt-skeleton-line slot="placeholder"></dotquilt-skeleton-line>
        <pre class="code"><code><span class="p">&lt;</span><span class="t">dotquilt-skeleton-text</span> <span class="a">lines</span>=<span class="s">"3"</span><span class="p">&gt;</span>
<span class="p">&lt;</span><span class="t">SkeletonText</span> <span class="a">lines</span>=<span class="p">{'{'}</span>3<span class="p">{'}'} /&gt;</span></code></pre>
      </dotquilt-region>
    </li>
    <li>
      <h3>Only what you use</h3>
      <p>
        Each component has its own entry point and registers itself on demand,
        so a page ships just the loaders it shows.
      </p>
      <dotquilt-region class="proof" state="ready" aria-label="Imports proof" data-arrival data-proof>
        <dotquilt-skeleton-line slot="placeholder"></dotquilt-skeleton-line>
        <pre class="code"><code><span class="k">import</span> {'{'} registerChartLoader {'}'} <span class="k">from</span> <span class="s">'dotquilt/chart'</span>;</code></pre>
      </dotquilt-region>
    </li>
  </ul>
</section>

<script>
  import { arriving, load, type Owner, restart, still, whenSeen } from '../arrive';

  const root = document.querySelector<HTMLElement>('[data-features]');
  if (root) {
    const proofs = [...root.querySelectorAll<Owner>('[data-proof]')];

    // Calm: a real idle, timed by the loader itself. Its marks move while
    // the loader marks itself as moving; the readout shows when that ends.
    const calm = root.querySelector<Owner>('[data-calm]');
    const line = root.querySelector<HTMLElement>('[data-calm-line]');
    const readout = root.querySelector<HTMLElement>('[data-calm-status]');
    if (calm && line && readout) {
      let started = 0;
      let frame = 0;
      let rested = false;
      const seconds = () => ((performance.now() - started) / 1000).toFixed(1);
      const tick = () => {
        readout.textContent = `Drifting… ${seconds()} s`;
        frame = requestAnimationFrame(tick);
      };
      // The loader marks itself as moving while its idle plays.
      new MutationObserver(() => {
        cancelAnimationFrame(frame);
        if (line.hasAttribute('data-moving')) tick();
        else if (started) {
          rested = true;
          readout.textContent = `Rested after ${seconds()} s.`;
        }
      }).observe(line, { attributes: true, attributeFilter: ['data-moving'] });
      const watch = () => {
        if (still()) {
          readout.textContent = 'Still: your system asks for reduced motion.';
          return;
        }
        rested = false;
        started = performance.now();
        restart(calm, () => {
          started = performance.now();
        });
      };
      // Timed only while it is on screen: leaving early starts it over on
      // the way back, so the reading stays true.
      let ready = false;
      new IntersectionObserver(
        ([entry]) => {
          if (!ready || !entry) return;
          if (entry.isIntersecting && !rested && !started) watch();
          else if (!entry.isIntersecting && !rested) {
            cancelAnimationFrame(frame);
            started = 0;
            readout.textContent = 'Resting.';
          }
        },
        { threshold: 0.6 },
      ).observe(calm);
      root.querySelector('[data-calm-again]')?.addEventListener('click', watch);
      root.addEventListener(
        'vb-proofs-in',
        () => {
          ready = true;
          watch();
        },
        { once: true },
      );
    }

    // Accessible: a pause stills every loader inside, as reduced motion does.
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]');
    const pausable = root.querySelector<Owner>('[data-pausable]');
    pause?.addEventListener('click', () => {
      if (!pausable) return;
      const paused = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(paused));
      pause.textContent = paused ? 'Resume motion' : 'Pause motion';
      if (paused) pausable.setAttribute('motion', 'paused');
      else {
        pausable.removeAttribute('motion');
        // The idle may have rested already; a new period plays it again.
        restart(pausable);
      }
    });

    // The arrival: the proofs hand over row after row.
    if (arriving())
      whenSeen(root.querySelector('.rows') ?? root, () => {
        proofs.forEach((proof, i) => load(proof, 600 + i * 160));
        setTimeout(
          () => root.dispatchEvent(new Event('vb-proofs-in')),
          600 + proofs.length * 160 + 900,
        );
      }, 0.2);
    else root.dispatchEvent(new Event('vb-proofs-in'));
  }
</script>

<style>
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--dq-line);
  }
  .rows > li {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) minmax(0, 1fr) minmax(0, 24rem);
    gap: 0.5rem 2.5rem;
    align-items: start;
    max-width: none;
    padding: 1.5rem 0;
    border-top: 1px solid var(--dq-line);
  }
  h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--dq-ink);
  }
  .rows > li > p {
    margin: 0;
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--dq-muted);
  }
  .proof {
    min-height: 2.75rem;
  }
  .proof > dotquilt-skeleton-line {
    width: 70%;
  }
  .code {
    margin: 0;
    padding: 0.75rem 0.875rem;
    overflow-x: auto;
    border-radius: var(--dq-radius-md);
    background: var(--dq-code-bg);
    color: var(--dq-code-fg);
    font: 0.75rem / 1.6 var(--dq-font-mono);
  }
  .code code {
    padding: 0;
    background: none;
    color: inherit;
    font: inherit;
    white-space: pre-wrap;
  }
  .k {
    color: var(--dq-code-keyword);
  }
  .s {
    color: var(--dq-code-string);
  }
  .t {
    color: var(--dq-code-type);
  }
  .a {
    color: var(--dq-code-attr);
  }
  .p {
    color: var(--dq-code-punct);
  }
  .calm,
  .pause {
    display: grid;
    gap: 0.625rem;
  }
  .calm dotquilt-region,
  .pause dotquilt-region {
    width: 100%;
  }
  .readout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--dq-muted);
  }
  .link {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--dq-accent);
    font: 500 0.8125rem / 1 var(--dq-font);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .link:focus-visible,
  .toggle:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--dq-accent);
    outline-offset: 2px;
  }
  .toggle {
    justify-self: start;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--dq-line-2);
    border-radius: var(--dq-radius-sm);
    background: var(--dq-surface);
    color: var(--dq-ink);
    font: 500 0.8125rem / 1 var(--dq-font);
    cursor: pointer;
    transition:
      background var(--dq-duration-ui) var(--dq-ease-settle),
      color var(--dq-duration-ui) var(--dq-ease-settle);
  }
  .toggle:hover {
    background: var(--dq-subtle);
  }
  .toggle[aria-pressed='true'] {
    border-color: var(--dq-ink);
    background: var(--dq-ink);
    color: var(--dq-surface);
  }
  .server {
    display: grid;
    gap: 0.5rem;
  }
  details {
    font-size: 0.8125rem;
    color: var(--dq-muted);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    cursor: pointer;
    color: var(--dq-ink);
    font-weight: 500;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* A small chevron that turns when the markup opens. */
  summary::before {
    content: '';
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    rotate: -45deg;
    transition: rotate var(--dq-duration-ui) var(--dq-ease-settle);
  }
  details[open] summary::before {
    rotate: 45deg;
  }
  details pre {
    max-height: 12rem;
    margin: 0.25rem 0 0;
    padding: 0.75rem;
    overflow: auto;
    border-radius: var(--dq-radius-md);
    background: var(--dq-code-bg);
  }
  details code {
    padding: 0;
    background: none;
    color: var(--dq-code-fg);
    font: 0.6875rem / 1.55 var(--dq-font-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  @media (max-width: 64rem) {
    .rows > li {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    }
    .proof {
      grid-column: 2;
    }
  }
  @media (max-width: 40rem) {
    .rows > li {
      grid-template-columns: minmax(0, 1fr);
    }
    .proof {
      grid-column: auto;
      margin-top: 0.5rem;
    }
  }
</style>
