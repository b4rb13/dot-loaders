---
/**
 * Starlight's SkipLink, the first thing in <body>, carrying the homepage's
 * design contract as an HTML comment so it survives the build (Impeccable's
 * direction contract; the surface brief lives in .impeccable/surfaces/).
 */
import Default from '@astrojs/starlight/components/SkipLink.astro';

const contract = `<!--
THESIS: The page is a loading screen caught mid-handoff: a field of marks rises into a solid chart line, so the product proves itself before a word is read. It refuses the headline-over-screenshot SaaS hero.
OWN-WORLD: Cool off-white plane; slate marks on a 22px grid fading downward and dissolving leftward; one muted teal for the arrived line and the primary action; white hairline cards; Manrope 500 display.
STORY: A visitor watches placeholders become content, reads "Loading states that hand over.", and starts with the docs.
FIRST VIEWPORT: Left, a 72px two-line headline, a one-line lead, teal Get started and outline See the components. Right half to the edge, the field with a rising trail of marks becoming a teal line. Bottom, three metric cards whose values lock in from square marks.
FORM: The field becomes the page, option 1 of 3, seed ee7c71ed.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`;
const home = Astro.url.pathname === '/';
---

{home && <Fragment set:html={contract} />}
<Default />
