---
/**
 * The page footer (Starlight's Footer, overridden): Starlight's own page
 * footer, then the site footer with the brand, links and the license. It is
 * on every page, so it also carries Vercel Web Analytics (cookieless, served
 * from the site's own origin).
 */
import Default from '@astrojs/starlight/components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { repository } from '../../lib/github';
import Glyph from './Glyph.astro';

const columns = [
  {
    title: 'Components',
    links: [
      ['Skeleton', '/docs/components/skeleton/'],
      ['TextLoader', '/docs/components/text-loader/'],
      ['ChartLoader', '/docs/components/chart-loader/'],
      ['TableLoader', '/docs/components/table-loader/'],
      ['TypingDots', '/docs/components/typing-dots/'],
      ['LoadingRegion', '/docs/components/loading-region/'],
    ],
  },
  {
    title: 'Frameworks',
    links: [
      ['React and Next.js', '/docs/guides/react/'],
      ['Vue and Nuxt', '/docs/guides/vue/'],
      ['Svelte and SvelteKit', '/docs/guides/svelte/'],
      ['Angular', '/docs/guides/angular/'],
    ],
  },
  {
    title: 'Learn',
    links: [
      ['Introduction', '/docs/'],
      ['Installation', '/docs/installation/'],
      ['Server rendering', '/docs/guides/server-rendering/'],
      ['Motion and accessibility', '/docs/guides/motion/'],
      ['Skeleton loader or spinner?', '/docs/guides/skeleton-or-spinner/'],
    ],
  },
  {
    title: 'Project',
    links: [
      ['GitHub', repository],
      ['Changelog', '/docs/changelog/'],
      ['Pricing', '/pricing/'],
      ['Theming', '/docs/theming/'],
      ['Content Security Policy', '/docs/guides/csp/'],
      ['Custom animations', '/docs/guides/custom-animations/'],
      ['MIT License', '/license/'],
    ],
  },
];
// On the home page the closing field hands straight to the footer's seam.
// Marked here rather than with `:root:has(...)` in CSS: a `:has()` anchored
// on the root makes Chromium restyle the whole page on every DOM change.
const home = Astro.url.pathname === '/';
---

<Default {...Astro.props}><slot /></Default>
<footer class:list={['site-footer', 'not-content', { home }]}>
  <dotquilt-skeleton-block class="seam" motion="paused" aria-hidden="true"
  ></dotquilt-skeleton-block>
  <div class="grid">
    <div class="about">
      <a class="brand" href="/"><Glyph /> <span>dotquilt</span></a>
      <p>
        Loading placeholders that hold the shape of your content and hand over
        gently when it arrives.
      </p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          {column.links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="bottom">
    <p>© 2026 Dotquilt. Free and open source under the MIT license.</p>
    <nav aria-label="About this site" class="trust">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
    </nav>
  </div>
</footer>
<Analytics />

<script>
  import { registerSkeletonBlock } from 'dotquilt/skeleton';

  registerSkeletonBlock();
</script>

<style>
  .site-footer {
    position: relative;
    margin-top: 4rem;
    padding-top: 2.75rem;
  }
  .site-footer.home {
    margin-top: 0;
  }
  .seam {
    position: absolute;
    inset-inline: 0;
    top: 0;
    width: auto;
    height: 9px;
    border-radius: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--dq-ink);
    text-decoration: none;
  }
  .about p {
    margin: 0.875rem 0 0;
    max-width: 22rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--dq-muted);
  }
  nav {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  h2 {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--dq-ink);
  }
  nav a {
    font-size: 0.875rem;
    color: var(--dq-muted);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--dq-ink);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin: 2.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--dq-line);
    font-size: 0.8125rem;
    color: var(--dq-faint);
  }
  .bottom p {
    margin: 0;
  }
  .trust {
    display: flex;
    gap: 1.25rem;
  }
  .trust a {
    font-size: 0.8125rem;
    color: var(--dq-faint);
  }
  .trust a:hover {
    color: var(--dq-ink);
  }
  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
