---
/**
 * The site header (Starlight's Header, overridden): the Quilt mark and a
 * wordmark that, on a first visit, shimmers in square marks and locks into the
 * name; the main links; search, the repository on GitHub with its star count,
 * and theme. A row of marks forms its lower edge.
 *
 * On phones the main links and theme move into a menu. Pages with a sidebar
 * use Starlight's own menu button; pages without one (the splash pages) get a
 * matching button, in the same place, that opens a panel under the header.
 */
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import { Icon } from '@astrojs/starlight/components';
import { repository, shortCount, starCount } from '../../lib/github';
import Glyph from './Glyph.astro';

const stars = await starCount();
const { hasSidebar } = Astro.locals.starlightRoute;

const path = Astro.url.pathname;
const links = [
  {
    label: 'Docs',
    href: '/docs/',
    current:
      path.startsWith('/docs/') && !/\/docs\/(components|guides)\//.test(path),
  },
  {
    label: 'Components',
    href: '/docs/components/skeleton/',
    current: path.startsWith('/docs/components/'),
  },
  {
    label: 'Guides',
    href: '/docs/guides/react/',
    current: path.startsWith('/docs/guides/'),
  },
  {
    label: 'Examples',
    href: '/examples/',
    current: path.startsWith('/examples/'),
  },
  {
    label: 'Playground',
    href: '/playground/',
    current: path.startsWith('/playground/'),
  },
  { label: 'Pricing', href: '/pricing/', current: path === '/pricing/' },
];
---

<div class="site-header">
  <a class="brand" href="/" aria-label="Dotquilt, home">
    <Glyph />
    <dotquilt-text-loader
      class="wordmark"
      mask="dotquilt"
      mark="square"
      aria-hidden="true"
      data-wordmark>dotquilt</dotquilt-text-loader
    >
  </a>
  <script is:inline>
    // A first visit plays the arrival, before anything paints. Later pages
    // in the same visit, and reduced motion, show the header at rest. The
    // home page's first screen is its one focal motion, so the header rests
    // there too, and counts as arrived.
    try {
      const brand = document.currentScript.previousElementSibling;
      const seen = sessionStorage.getItem('dotquilt-arrived');
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (location.pathname === '/') sessionStorage.setItem('dotquilt-arrived', '1');
      else if (!seen && !still) {
        brand.querySelector('[data-wordmark]').setAttribute('state', 'pending');
        document.documentElement.dataset.arrival = '';
      }
    } catch {}
  </script>
  <nav class="site-nav" aria-label="Main">
    {
      links.map((link) => (
        <a href={link.href} aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="search"><Search /></div>
  <a class="github" href={repository} data-github>
    <svg class="mark" viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
      ></path>
    </svg>
    <span class="name">GitHub</span>
    {
      stars !== undefined && (
        <span class="stars" data-stars>
          <svg class="star" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 .9l2.15 4.36 4.81.7-3.48 3.39.82 4.79L8 11.88l-4.3 2.26.82-4.79L1.04 5.96l4.81-.7z" />
          </svg>
          {shortCount(stars)}
          <span class="sr-only">{stars === 1 ? 'star' : 'stars'}</span>
        </span>
      )
    }
  </a>
  <div class="tools"><ThemeSelect /></div>
  {
    !hasSidebar && (
      <>
        <button
          class="menu-button"
          type="button"
          popovertarget="site-menu"
          aria-controls="site-menu"
          data-menu-button
        >
          <Icon name="bars" class="open" />
          <Icon name="close" class="close" />
          <span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
        </button>
        <div id="site-menu" class="site-menu" popover data-menu>
          <nav aria-label="Main">
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={link.current ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <div class="menu-theme">
            <span aria-hidden="true">Theme</span>
            <ThemeSelect />
          </div>
        </div>
      </>
    )
  }
  <dotquilt-skeleton-block class="seam" motion="paused" aria-hidden="true"
  ></dotquilt-skeleton-block>
</div>

<script>
  import { registerSkeletonBlock } from 'dotquilt/skeleton';
  import { registerTextLoader, type TextLoader } from 'dotquilt/text';

  const root = document.documentElement;
  const seam = document.querySelector('.site-header .seam');
  // On arrival the glow drifts along the seam once; otherwise it rests.
  if ('arrival' in root.dataset) seam?.setAttribute('motion', 'system');
  registerSkeletonBlock();
  registerTextLoader();
  const wordmark = document.querySelector<TextLoader>('[data-wordmark]');
  if (wordmark?.state === 'pending') {
    setTimeout(() => {
      wordmark.update({ state: 'ready' });
      try {
        sessionStorage.setItem('dotquilt-arrived', '1');
      } catch {}
    }, 1200);
  }

  // The phone menu on pages without a sidebar. The popover opens and closes
  // it, with Escape and a tap outside, even before this script runs.
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const menuButton = document.querySelector<HTMLElement>('[data-menu-button]');
  if (menu && menuButton) {
    const close = () => {
      if (menu.matches(':popover-open')) menu.hidePopover();
    };
    menuButton.setAttribute('aria-expanded', 'false');
    menu.addEventListener('toggle', (event) => {
      const open = (event as ToggleEvent).newState === 'open';
      menuButton.setAttribute('aria-expanded', String(open));
    });
    // Escape returns focus to the button, wherever it was in the menu.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.matches(':popover-open')) return;
      close();
      menuButton.focus();
    });
    // It closes when focus moves on past it, when a link is followed (so the
    // back button doesn't restore it open), and when the page widens.
    menu.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && next !== menuButton && !menu.contains(next))
        close();
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) close();
    });
    matchMedia('(width > 50rem)').addEventListener('change', close);
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    color: var(--dq-ink);
    text-decoration: none;
  }
  .wordmark {
    min-width: 4.4em;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--dq-ink);
  }
  /* Until the wordmark upgrades, a pending one shows nothing rather than the name. */
  .wordmark:not(:defined)[state='pending'] {
    color: transparent;
  }
  .site-nav {
    display: flex;
    gap: 0.25rem;
  }
  .site-nav a {
    padding: 0.4375rem 0.75rem;
    border-radius: var(--dq-radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dq-muted);
    text-decoration: none;
    transition: background var(--dq-duration-ui) var(--dq-ease-settle);
  }
  .site-nav a:hover {
    background: var(--dq-subtle);
    color: var(--dq-ink);
  }
  .site-nav a[aria-current='page'] {
    color: var(--dq-ink);
    background: var(--dq-subtle);
  }
  .search {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }
  .tools {
    display: flex;
    align-items: center;
  }
  /* The repository: GitHub's mark and name, then the star count, in one
     quiet pill like the nav links. */
  .github {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    border: 1px solid var(--dq-line);
    border-radius: var(--dq-radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dq-muted);
    text-decoration: none;
    transition:
      background var(--dq-duration-ui) var(--dq-ease-settle),
      color var(--dq-duration-ui) var(--dq-ease-settle);
  }
  .github:hover {
    background: var(--dq-subtle);
    color: var(--dq-ink);
  }
  .github:focus-visible {
    outline: 2px solid var(--dq-focus);
    outline-offset: 2px;
  }
  .github svg {
    flex: none;
    fill: currentColor;
  }
  .github .mark {
    width: 1rem;
    height: 1rem;
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-left: 0.5rem;
    border-left: 1px solid var(--dq-line);
    font-variant-numeric: tabular-nums;
    color: var(--dq-ink);
  }
  .stars .star {
    width: 0.8125rem;
    height: 0.8125rem;
    color: var(--dq-muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* A single row of marks along the header's lower edge. */
  .seam {
    position: absolute;
    inset-inline: 0;
    /* Positioned against the fixed header itself: inside its lower edge,
       so it never covers the page. */
    bottom: 0;
    width: auto;
    height: 9px;
    border-radius: 0;
    pointer-events: none;
  }
  /* The phone menu (pages without a sidebar). Its button matches Starlight's
     on docs pages: the same size, place and quiet fill. */
  .menu-button {
    display: none;
  }
  .menu-button:has(+ :popover-open) {
    box-shadow: none;
  }
  .menu-button:has(+ :popover-open) :global(.open),
  .menu-button:not(:has(+ :popover-open)) :global(.close) {
    display: none;
  }
  /* A panel under the header: the main links, then the theme. It settles in
     with the site's UI timing; a light scrim covers the page below. */
  .site-menu {
    --rise: -0.25rem;
    position: fixed;
    inset: var(--sl-nav-height) 0 auto;
    width: auto;
    height: auto;
    max-height: calc(100dvh - var(--sl-nav-height));
    margin: 0;
    padding: 0.5rem var(--sl-nav-pad-x) 1rem;
    overflow-y: auto;
    border: 0;
    border-bottom: 1px solid var(--dq-line);
    background: var(--dq-surface);
    color: var(--dq-ink);
    box-shadow: var(--dq-shadow-lg);
    opacity: 0;
    translate: 0 var(--rise);
    transition:
      opacity var(--dq-duration-ui) var(--dq-ease-fade),
      translate var(--dq-duration-ui) var(--dq-ease-settle),
      overlay var(--dq-duration-ui) allow-discrete,
      display var(--dq-duration-ui) allow-discrete;
  }
  .site-menu:popover-open {
    opacity: 1;
    translate: 0;
  }
  @starting-style {
    .site-menu:popover-open {
      opacity: 0;
      translate: 0 var(--rise);
    }
  }
  .site-menu::backdrop {
    /* Below the header, which stays as it is. */
    inset: 3.5rem 0 0;
    background: rgb(27 34 48 / 0.18);
    opacity: 0;
    transition:
      opacity var(--dq-duration-ui) var(--dq-ease-fade),
      overlay var(--dq-duration-ui) allow-discrete,
      display var(--dq-duration-ui) allow-discrete;
  }
  :global([data-theme='dark']) .site-menu::backdrop {
    background: rgb(6 9 15 / 0.45);
  }
  .site-menu:popover-open::backdrop {
    opacity: 1;
  }
  @starting-style {
    .site-menu:popover-open::backdrop {
      opacity: 0;
    }
  }
  .site-menu nav {
    display: grid;
    gap: 0.125rem;
  }
  .site-menu a {
    padding: 0.75rem;
    border-radius: var(--dq-radius-sm);
    font-size: 1rem;
    font-weight: 500;
    color: var(--dq-muted);
    text-decoration: none;
    transition: background var(--dq-duration-ui) var(--dq-ease-settle);
  }
  .site-menu a:hover,
  .site-menu a[aria-current='page'] {
    background: var(--dq-subtle);
    color: var(--dq-ink);
  }
  .menu-theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    padding: 0.75rem 0.75rem 0;
    border-top: 1px solid var(--dq-line);
    font-size: 0.875rem;
    color: var(--dq-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-menu {
      --rise: 0px;
    }
  }
  @media (forced-colors: active) {
    .menu-button {
      border: 1px solid ButtonText;
    }
    .site-menu {
      border: 1px solid CanvasText;
    }
    .site-menu a[aria-current='page'] {
      outline: 1px solid CanvasText;
    }
  }
  /* Wider than the phone layout below, the header shows the links itself. */
  @media (width > 50rem) {
    .site-menu {
      display: none;
    }
  }
  @media (max-width: 50rem) {
    .site-nav,
    .tools {
      display: none;
    }
    .menu-button {
      display: grid;
      flex: none;
      place-items: center;
      width: var(--sl-menu-button-size);
      height: var(--sl-menu-button-size);
      /* With the header's gap, the same space Starlight leaves before its
         button. */
      margin-inline-start: calc(var(--sl-nav-gap) - 0.75rem);
      padding: 0.5rem;
      border: 0;
      border-radius: 50%;
      background: var(--dq-bg);
      color: var(--dq-ink);
      box-shadow: var(--sl-shadow-md);
      font-size: 1rem;
      cursor: pointer;
    }
    /* Phones: the mark and the count; the name is read, not shown. */
    .github {
      height: 2.5rem;
      padding: 0 0.625rem;
    }
    .github .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .site-header {
      gap: 0.75rem;
    }
  }
  @media print {
    .menu-button {
      display: none;
    }
  }
</style>
