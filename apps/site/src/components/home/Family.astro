---
/** Six live tiles, one per loader, each in the content it stands in for. */
import { linePath } from '../../../../../examples/site/data';
import { weekly } from './data';

const spark = linePath(weekly, 240, 80);
---

<section class="home-section not-content" aria-labelledby="family-title">
  <header>
    <h2 id="family-title">One quiet language for every wait.</h2>
    <p>
      A number, a chart, a table and a reply all take their own time. Each
      loader holds the shape of what it stands for, so the page keeps its
      structure while it fills in. Hover a tile to watch it load again.
    </p>
  </header>
  <div class="family" data-family>
    <a class="tile home-card" href="/docs/components/skeleton/" data-tile>
      <div class="stage">
        <dotquilt-region state="pending" aria-label="Profile" data-owner>
          <div slot="placeholder" class="profile">
            <dotquilt-skeleton-circle></dotquilt-skeleton-circle>
            <div class="lines">
              <dotquilt-skeleton-line></dotquilt-skeleton-line>
              <dotquilt-skeleton-line style="width: 60%"></dotquilt-skeleton-line>
            </div>
          </div>
          <div class="profile">
            <span class="initials">AL</span>
            <div><strong>Ada Lovelace</strong><br /><span class="muted">Analytical engines</span></div>
          </div>
        </dotquilt-region>
      </div>
      <h3>Skeleton</h3>
      <p>Images, text, avatars and paragraphs.</p>
    </a>

    <a class="tile home-card" href="/docs/components/text-loader/" data-tile>
      <div class="stage">
        <p class="figure">
          <dotquilt-text-loader
            state="pending"
            mask="$00,000"
            aria-label="Revenue"
            data-owner
            data-value="$48,210"></dotquilt-text-loader>
        </p>
      </div>
      <h3>TextLoader</h3>
      <p>Numbers and short labels that lock into place.</p>
    </a>

    <a class="tile home-card" href="/docs/components/chart-loader/" data-tile>
      <div class="stage">
        <dotquilt-region state="pending" aria-label="Revenue chart" data-owner>
          <dotquilt-chart-loader slot="placeholder" data-spark></dotquilt-chart-loader>
          <svg class="spark" viewBox="0 0 240 80" preserveAspectRatio="none" aria-hidden="true">
            <path d={spark} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke"></path>
          </svg>
        </dotquilt-region>
      </div>
      <h3>ChartLoader</h3>
      <p>Marks that glide onto your real line.</p>
    </a>

    <a class="tile home-card" href="/docs/components/table-loader/" data-tile>
      <div class="stage">
        <dotquilt-region state="pending" aria-label="Invoices" data-owner data-rows>
          <dotquilt-table-loader slot="placeholder" rows="3" row-height="26"></dotquilt-table-loader>
          <table class="mini-table">
            <tbody>
              <tr><td>Northwind</td><td>$4,200</td><td><span class="pill">Paid</span></td></tr>
              <tr><td>Acme Labs</td><td>$1,870</td><td><span class="pill">Sent</span></td></tr>
              <tr><td>Globex</td><td>$9,640</td><td><span class="pill">Due</span></td></tr>
            </tbody>
          </table>
        </dotquilt-region>
      </div>
      <h3>TableLoader</h3>
      <p>Rows that settle in one after another.</p>
    </a>

    <a class="tile home-card" href="/docs/components/typing-dots/" data-tile>
      <div class="stage">
        <dotquilt-region state="pending" aria-label="Reply" data-owner>
          <div slot="placeholder" class="bubble"><dotquilt-typing-dots></dotquilt-typing-dots></div>
          <div class="bubble">Your invoice is on its way.</div>
        </dotquilt-region>
      </div>
      <h3>TypingDots</h3>
      <p>A reply that is being written.</p>
    </a>

    <a class="tile home-card" href="/docs/components/loading-region/" data-tile>
      <div class="stage">
        <dotquilt-region state="pending" aria-label="Activity" data-owner data-refresh>
          <dotquilt-skeleton-text slot="placeholder" lines="3"></dotquilt-skeleton-text>
          <span slot="refresh-indicator" class="updating">Updating</span>
          <ul class="activity">
            <li>Northwind paid $4,200</li>
            <li>Globex invoice is overdue</li>
            <li>Initech paid $3,115</li>
          </ul>
        </dotquilt-region>
      </div>
      <h3>LoadingRegion</h3>
      <p>Switches to your content, or keeps it usable while it refreshes.</p>
    </a>
  </div>
</section>

<script>
  import type { ChartLoader } from '@dotquilt-internal/core/chart';
  import type { LoadingRegion } from '@dotquilt-internal/core/region';
  import { registerAll } from '@dotquilt-internal/core/register-all';
  import type { TableLoader } from '@dotquilt-internal/core/table';
  import type { TextLoader } from '@dotquilt-internal/core/text';
  import { linePoints } from '../../../../../examples/site/data';
  import { weekly } from './data';

  registerAll();
  const family = document.querySelector<HTMLElement>('[data-family]');
  if (family) {
    for (const chart of family.querySelectorAll<ChartLoader>('[data-spark]'))
      chart.targetProvider = ({ width, height }) => ({
        kind: 'line',
        points: linePoints(weekly, width, height),
        baseline: height,
      });
    for (const table of family.querySelectorAll<TableLoader>('dotquilt-table-loader'))
      table.columns = [{ kind: 'text', width: 1.6 }, { kind: 'number' }, { kind: 'badge' }];
    for (const region of family.querySelectorAll<LoadingRegion>('[data-rows]'))
      region.revealTargets = [...(region.querySelector('tbody')?.rows ?? [])].map(
        (element, i) => ({ id: `row-${i}`, element }),
      );

    const tiles = [...family.querySelectorAll<HTMLElement>('[data-tile]')];
    const loads = new WeakMap<HTMLElement, number>();
    let count = 0;

    /** One load: the placeholder, then the content after `ms`. */
    function load(tile: HTMLElement, ms: number) {
      const owner = tile.querySelector<(LoadingRegion | TextLoader) & HTMLElement>(
        '[data-owner]',
      );
      if (!owner) return;
      const cycle = `tile-${++count}`;
      loads.set(tile, count);
      // A loaded region refreshes instead: the content stays usable.
      const refresh = owner.hasAttribute('data-refresh') && owner.state === 'ready';
      owner.update({ state: refresh ? 'refreshing' : 'pending', cycle });
      setTimeout(() => {
        if (owner.cycle !== cycle) return;
        if (owner.dataset.value) owner.textContent = owner.dataset.value;
        owner.update({ state: 'ready' });
      }, ms);
    }

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        tiles.forEach((tile, i) => load(tile, 1400 + i * 280));
      },
      { threshold: 0.3 },
    ).observe(family);

    for (const tile of tiles) {
      const again = () => {
        const owner = tile.querySelector<LoadingRegion | TextLoader>('[data-owner]');
        // Only a finished tile loads again, so a hover never cuts a handoff.
        if (owner?.state === 'ready' && owner.presentation === 'ready') load(tile, 1600);
      };
      tile.addEventListener('pointerenter', again);
      tile.addEventListener('focus', again);
    }
  }
</script>

<style>
  .family {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .tile {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: 1.25rem 1.375rem 1.375rem;
    color: inherit;
    text-decoration: none;
    transition:
      box-shadow var(--dq-duration-ui) var(--dq-ease-settle),
      translate var(--dq-duration-ui) var(--dq-ease-settle);
  }
  .tile:hover {
    box-shadow: var(--dq-shadow-lg);
    translate: 0 -2px;
  }
  .tile:focus-visible {
    outline: 2px solid var(--dq-accent);
    outline-offset: 2px;
  }
  .stage {
    display: grid;
    align-items: center;
    height: 8.5rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--dq-line);
    overflow: hidden;
  }
  .tile h3 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--dq-ink);
  }
  .tile > p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--dq-muted);
  }
  .profile {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.875rem;
    font-size: 0.875rem;
    color: var(--dq-ink);
  }
  .profile dotquilt-skeleton-circle {
    width: 2.75rem;
  }
  .lines {
    display: grid;
    gap: 0.5rem;
  }
  .initials {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--dq-subtle);
    font-weight: 600;
    color: var(--dq-muted);
  }
  .muted {
    color: var(--dq-muted);
  }
  .figure {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
    color: var(--dq-ink);
  }
  .stage dotquilt-chart-loader,
  .spark {
    display: block;
    width: 100%;
    height: 5.5rem;
  }
  .spark {
    color: var(--dq-accent);
  }
  .mini-table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.75rem;
    display: table;
    color: var(--dq-ink);
  }
  .mini-table td {
    height: 26px;
    padding: 0 0.25rem;
    border: 0;
  }
  .pill {
    padding: 0.0625rem 0.4375rem;
    border-radius: 999px;
    background: var(--dq-subtle);
    font-size: 0.6875rem;
    color: var(--dq-muted);
  }
  .bubble {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--dq-radius-md) var(--dq-radius-md) var(--dq-radius-md) 4px;
    background: var(--dq-subtle);
    border: 1px solid var(--dq-line);
    font-size: 0.875rem;
    color: var(--dq-ink);
  }
  .activity {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.8125rem;
    color: var(--dq-ink);
  }
  .updating {
    position: absolute;
    inset-block-start: -0.25rem;
    inset-inline-end: -0.25rem;
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: var(--dq-subtle);
    font-size: 0.6875rem;
    color: var(--dq-muted);
  }
  :is(dotquilt-region, dotquilt-text-loader):not(:defined) > :not([slot]) {
    visibility: hidden;
  }
  @media (max-width: 64rem) {
    .family {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .family {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
