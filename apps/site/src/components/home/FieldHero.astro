---
/**
 * The homepage's first screen: a field of marks rises into a solid chart line
 * beside the headline, and three metrics below it hand over from square marks.
 * Built from the approved comp (.impeccable/mocks/decision/field.png); the
 * surface brief in .impeccable/surfaces/ holds its measurements.
 *
 * Every position here is in the drawing's own units: 850 × 600, which is
 * exactly its size at a 1440 px wide window. Narrower windows scale it down.
 */
import { kpis } from './data';

interface Props {
  title: string;
  tagline?: string;
}
const { title, tagline } = Astro.props;
// "Loading states that hand over." breaks after its second word, as in the comp.
const [first, ...rest] = title.split(' ');
const lines = [`${first} ${rest.shift() ?? ''}`.trim(), rest.join(' ')];

/** The rising trail of marks, left to right, ending where the line begins. */
const trail = [
  [73, 563],
  [95, 551],
  [116, 538],
  [140, 532],
  [165, 527],
  [190, 521],
  [210, 516],
  [230, 508],
  [247, 497],
  [264, 486],
  [279, 479],
  [298, 473],
  [314, 465],
  [330, 456],
  [345, 445],
  [366, 433],
];
/** The arrived chart: its turning points, from the junction to the end. */
const line = [
  [385, 421],
  [436, 401],
  [475, 380],
  [536, 375],
  [599, 333],
  [677, 328],
  [812, 252],
];
const path = line.map(([x, y], i) => `${i ? 'L' : 'M'}${x} ${y}`).join(' ');
/**
 * The field's dissolving left edge: x, y and opacity of each loose mark,
 * read from the comp. The four at full strength are marks at their peak.
 */
const edge = [
  [144, 38, 0.9],
  [75, 58, 0.38],
  [166, 67, 0.9],
  [108, 77, 0.32],
  [139, 100, 0.9],
  [122, 120, 0.31],
  [83, 130, 0.3],
  [164, 135, 0.9],
  [144, 163, 0.31],
  [77, 164, 0.34],
  [97, 183, 0.26],
  [166, 187, 0.3],
  [165, 210, 0.22],
  [124, 215, 0.24],
  [165, 231, 0.19],
  [141, 250, 0.22],
  [165, 252, 0.14],
  [92, 264, 0.24],
  [165, 273, 0.15],
  [142, 274, 0.17],
  [124, 295, 0.21],
  [164, 295, 0.11],
  [141, 295, 0.15],
  [164, 316, 0.13],
  [141, 316, 0.14],
  [103, 332, 0.27],
  [164, 338, 0.13],
  [141, 338, 0.14],
  [131, 358, 0.23],
  [164, 360, 0.12],
  [141, 360, 0.14],
  [126, 381, 0.18],
  [142, 381, 0.14],
  [164, 381, 0.13],
  [104, 390, 0.25],
  [128, 402, 0.21],
  [141, 403, 0.14],
  [164, 403, 0.12],
  [112, 419, 0.25],
  [144, 423, 0.23],
  [164, 424, 0.1],
  [91, 427, 0.26],
  [116, 445, 0.18],
  [142, 446, 0.11],
  [98, 457, 0.32],
  [119, 467, 0.1],
  [142, 467, 0.1],
  [71, 473, 0.26],
  [95, 489, 0.23],
  [119, 489, 0.1],
  [52, 496, 0.27],
  [80, 507, 0.26],
  [141, 510, 0.11],
  [96, 510, 0.12],
  [43, 526, 0.31],
  [11, 526, 0.22],
  [96, 532, 0.12],
  [68, 540, 0.26],
  [22, 550, 0.33],
  [46, 555, 0.19],
  [1, 570, 0.28],
  [73, 575, 0.12],
  [25, 575, 0.14],
  [46, 575, 0.1],
  [96, 596, 0.1],
  [29, 597, 0.11],
  [51, 597, 0.12],
];
/** When each metric's value arrives, in ms after the page shows. */
const arrivals = [1200, 1900, 2600];
---

<section class="field-hero not-content" data-field-hero>
  <div class="inner">
    <div class="copy">
      <h1 id="_top" data-page-title>
        {lines[0]}<br />{lines[1]}
      </h1>
      {tagline && <p class="lead">{tagline}</p>}
      <div class="actions">
        <a class="home-button primary" href="/docs/">Get started</a>
        <a class="home-button" href="/docs/components/skeleton/">See the components</a>
      </div>
    </div>

    <div class="art" aria-hidden="true">
      <dotquilt-skeleton-block class="field"></dotquilt-skeleton-block>
      <svg class="drawing" viewBox="0 0 1500 600" focusable="false">
        <g class="edge">
          {
            edge.map(([x, y, o]) => (
              <circle cx={x} cy={y} r="1.4" style={`opacity:${o}`} />
            ))
          }
        </g>
        <g class="trail">
          {
            trail.map(([x, y], i) => (
              <circle cx={x} cy={y} r="3.2" style={`--i:${i}`} />
            ))
          }
        </g>
        <path class="line" d={path} pathLength="1"></path>
        <circle class="junction" cx={line[0][0]} cy={line[0][1]} r="4.4"></circle>
      </svg>
    </div>

    <div class="metrics" role="group" aria-label="Example metrics">
      {
        kpis.map((kpi, i) => (
          <div class="home-card metric">
            <p class="label">{kpi.label}</p>
            <p class="value">
              <dotquilt-text-loader
                mark="square"
                mask={kpi.mask}
                aria-label={kpi.label}
                data-at={arrivals[i]}>{kpi.value}</dotquilt-text-loader
              >
            </p>
          </div>
        ))
      }
    </div>
    <p class="caption">Example data. Each value is a live TextLoader.</p>
  </div>
</section>
<script is:inline>
  // Before anything paints: when motion is allowed, the first screen arrives
  // (the line draws in, the values hand over). Otherwise it shows at rest.
  try {
    const hero = document.currentScript.previousElementSibling;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.dataset.arrive = '';
      for (const value of hero.querySelectorAll('dotquilt-text-loader'))
        value.setAttribute('state', 'pending');
    }
  } catch {}
</script>

<script>
  import { registerSkeletonBlock } from 'dotquilt/skeleton';
  import { registerTextLoader, type TextLoader } from 'dotquilt/text';

  registerSkeletonBlock();
  registerTextLoader();
  const hero = document.querySelector<HTMLElement>('[data-field-hero]');
  if (hero && 'arrive' in hero.dataset)
    for (const value of hero.querySelectorAll<TextLoader>('dotquilt-text-loader'))
      setTimeout(
        () => value.update({ state: 'ready' }),
        Number(value.dataset.at) || 1400,
      );
</script>

<style>
  .field-hero {
    /* The outer margin at 1440 px is 82 px, as in the comp. */
    --gutter: clamp(1.25rem, 5.7vw, 82px);
    --bleed: max(var(--gutter), (100vw - 1276px) / 2);
    position: relative;
    margin-inline: calc(50% - 50vw);
    overflow-x: clip;
  }
  .inner {
    display: grid;
    grid-template-columns: 508px 1fr;
    width: min(1276px, 100% - 2 * var(--gutter));
    margin-inline: auto;
  }
  .copy {
    grid-area: 1 / 1 / 2 / -1;
    position: relative;
    z-index: 1;
    padding-top: 185px;
  }
  h1#_top {
    margin: 0;
    font-size: 72px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--dq-ink);
    text-wrap: balance;
  }
  .lead {
    margin: 22px 0 0;
    max-width: 36rem;
    font-size: 18.75px;
    line-height: 1.5;
    color: var(--dq-muted);
    text-wrap: balance;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 40px;
  }
  .actions .home-button {
    height: 58px;
    padding: 0 28px;
    font-size: 17px;
    font-weight: 500;
  }

  /* The drawing runs from the copy to the window's right edge. Its units
     match CSS px at 1440 px wide; narrower art columns scale it down. */
  .art {
    grid-area: 1 / 2 / 2 / 3;
    position: relative;
    margin-right: calc(-1 * var(--bleed));
    container-type: inline-size;
    pointer-events: none;
  }
  .drawing {
    display: block;
    width: min(1500px, 176.47cqw);
    height: auto;
    overflow: visible;
  }
  .field {
    position: absolute;
    top: min(38px, 4.47cqw);
    left: min(186px, 21.88cqw);
    right: 0;
    height: min(562px, 66.12cqw);
    width: auto;
    border-radius: 0;
    /* Small, sparse marks, strongest at the top and fading downwards. */
    --dotquilt-dot-size: 2.8px;
    --dotquilt-dot-gap: 19.6px;
    /* Ink at the marks' resting opacity reads as a mark at its peak; the
       mask fades it to a whisper by the bottom. */
    --dotquilt-color: var(--dq-ink);
    mask: linear-gradient(
      rgb(0 0 0 / 0.81),
      rgb(0 0 0 / 0.55) 14%,
      rgb(0 0 0 / 0.33) 30%,
      rgb(0 0 0 / 0.19) 47%,
      rgb(0 0 0 / 0.16) 70%,
      rgb(0 0 0 / 0.13) 92%,
      #0000
    );
  }
  .edge circle {
    fill: var(--dq-mark);
  }
  .trail circle {
    fill: var(--dq-mark);
    opacity: 0.95;
  }
  .line {
    fill: none;
    stroke: var(--dq-accent);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .junction {
    fill: var(--dq-accent);
  }

  .metrics {
    grid-area: 2 / 1 / 3 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 57px;
  }
  .caption {
    grid-area: 3 / 1 / 4 / -1;
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--dq-muted);
  }
  .metric {
    height: 178px;
    padding: 28px 32px 0;
    box-sizing: border-box;
  }
  .label {
    margin: 0;
    font-size: 20.5px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--dq-muted);
  }
  .value {
    margin: 22px 0 0;
    font-size: 62px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
    color: var(--dq-ink);
  }
  /* Until the loader upgrades, a pending value shows nothing, not the number. */
  .value dotquilt-text-loader:not(:defined)[state='pending'] {
    color: transparent;
  }

  /* The arrival: the trail's marks rise from rest to full strength toward
     the line, then the line draws in from the junction as a soft blur
     clears. Teal stays on the arrived line. */
  [data-arrive] .trail circle {
    animation: travel 700ms var(--dq-ease-settle) both;
    animation-delay: calc(200ms + var(--i) * 45ms);
  }
  [data-arrive] .line {
    animation: draw var(--dq-duration-handoff) var(--dq-ease-settle) 900ms both;
  }
  [data-arrive] .junction {
    animation: arrive var(--dq-duration-fade) var(--dq-ease-settle) 850ms both;
  }
  @keyframes travel {
    from {
      opacity: 0.2;
    }
  }
  @keyframes draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      filter: blur(2px);
      opacity: 0.4;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
      filter: blur(0);
      opacity: 1;
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      scale: 0.4;
    }
  }
  .junction {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (max-width: 1180px) {
    .inner {
      grid-template-columns: minmax(0, 0.9fr) 1fr;
    }
    .copy {
      padding-top: clamp(96px, 14vw, 185px);
    }
    h1#_top {
      font-size: clamp(52px, 6.1vw, 72px);
    }
    .lead {
      max-width: 27rem;
    }
    .value {
      font-size: clamp(40px, 5vw, 62px);
    }
    .metric {
      height: auto;
      padding: 24px 26px 28px;
    }
  }
  @media (max-width: 900px) {
    .inner {
      grid-template-columns: 1fr;
    }
    .copy {
      grid-area: 1 / 1;
      padding-top: 40px;
    }
    h1#_top {
      font-size: clamp(40px, 11vw, 56px);
    }
    .lead {
      font-size: 17px;
    }
    .actions {
      gap: 12px;
      margin-top: 28px;
    }
    .actions .home-button {
      height: 50px;
      padding: 0 18px;
      font-size: 16px;
    }
    /* On a phone the drawing is its own band under the words, starting
       where the trail begins. */
    .art {
      grid-area: 2 / 1;
      /* Never taller than about 400 px: on tablets the band keeps its
         phone size and sits against the right edge. */
      width: min(100% + 2 * var(--gutter), 560px);
      justify-self: end;
      margin-top: 8px;
    }
    .metrics {
      grid-area: 3 / 1;
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 8px;
    }
    .caption {
      grid-area: 4 / 1;
    }
    .metric {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding: 20px 22px;
    }
    .value {
      margin: 0;
      font-size: 34px;
    }
  }
</style>
