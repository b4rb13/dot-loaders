---
/**
 * The handoff, slowed down: a live card and a timeline of its phases
 * (design/SPEC.md, "Handoff"), with a playhead that follows the real one.
 */
const total = 1100;
const tracks = [
  { label: 'Marks travel to the real lines and avatar', from: 0, to: 600 },
  { label: 'Content wipes in along a soft front', from: 505, to: 1100 },
  { label: 'Marks leave where the front passes', from: 505, to: 1100 },
];
---

<section class="home-section not-content handoff" aria-labelledby="handoff-title">
  <div class="copy">
    <h2 id="handoff-title">The marks become your content.</h2>
    <p>
      When your data lands, the marks don't vanish. They travel to its real
      shape: each line grows or shrinks to the length of your text, and the
      circle becomes the avatar. Then your content wipes in as they leave, in
      a little over a second, on long eased curves. Nothing flickers and
      nothing jumps at the end.
    </p>
    <div class="play">
      <button type="button" class="home-button" data-play="1100">Play</button>
      <button type="button" class="home-button" data-play="3800">Play slowly</button>
    </div>
  </div>

  <div class="stage home-card">
    <dotquilt-region state="pending" aria-label="A message" data-handoff>
      <div slot="placeholder" class="message">
        <dotquilt-skeleton-circle></dotquilt-skeleton-circle>
        <dotquilt-skeleton-text lines="3"></dotquilt-skeleton-text>
      </div>
      <article class="message">
        <span class="initials">IC</span>
        <div>
          <p class="who">Inês Costa <span>10:42</span></p>
          <p>
            The new layouts are approved. I've attached the final files and the
            invoice for the second phase.
          </p>
        </div>
      </article>
    </dotquilt-region>

    <div class="timeline" aria-hidden="true">
      {
        tracks.map((track) => (
          <div class="track">
            <span class="track-label">{track.label}</span>
            <span class="track-bar">
              <span
                class="track-fill"
                style={`left:${(track.from / total) * 100}%;width:${((track.to - track.from) / total) * 100}%`}
              />
            </span>
          </div>
        ))
      }
      <div class="ticks">
        <span>0</span><span data-mid>0.55 s</span><span data-end>1.1 s</span>
      </div>
      <span class="playhead" data-playhead></span>
    </div>
  </div>
</section>

<script>
  import type { LoadingRegion } from 'dotquilt/region';
  import { registerAll } from 'dotquilt/register-all';

  registerAll();
  const section = document.querySelector<HTMLElement>('.handoff');
  const region = section?.querySelector<LoadingRegion>('[data-handoff]');
  const playhead = section?.querySelector<HTMLElement>('[data-playhead]');
  if (section && region && playhead) {
    let duration = 1100;
    let count = 0;
    let timer: number | undefined;
    const label = (selector: string, seconds: number) => {
      const tick = section.querySelector(selector);
      if (tick) tick.textContent = `${Number(seconds.toFixed(2))} s`;
    };

    /** Load the card, then hand over after a short wait, at `ms` long. */
    function play(ms: number) {
      clearTimeout(timer);
      duration = ms;
      label('[data-mid]', ms / 2000);
      label('[data-end]', ms / 1000);
      const cycle = `handoff-${++count}`;
      region?.update({ state: 'pending', cycle });
      timer = window.setTimeout(() => {
        if (region?.cycle !== cycle) return;
        // timing.duration scales every part of the handoff together.
        region.update({ state: 'ready', timing: { duration } });
      }, 1200);
    }

    region.addEventListener('dotquilt-handoff-start', () => {
      playhead.getAnimations().forEach((animation) => animation.cancel());
      playhead.animate(
        [
          { left: '0%', opacity: 1 },
          { left: '100%', opacity: 1, offset: 0.98 },
          { left: '100%', opacity: 0 },
        ],
        { duration, easing: 'linear', fill: 'forwards' },
      );
    });

    for (const button of section.querySelectorAll<HTMLButtonElement>('[data-play]'))
      button.addEventListener('click', () => play(Number(button.dataset.play)));

    new IntersectionObserver(
      (entries, observer) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        play(1100);
      },
      { threshold: 0.5 },
    ).observe(region);
  }
</script>

<style>
  .handoff {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .copy p {
    margin: 1rem 0 0;
    line-height: 1.65;
    color: var(--dq-muted);
  }
  .play {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }
  .stage {
    display: grid;
    gap: 1.75rem;
    padding: 1.5rem;
  }
  .message {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
    min-height: 6rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--dq-ink);
  }
  .message dotquilt-skeleton-circle {
    width: 2.5rem;
  }
  .message p {
    margin: 0;
  }
  .who {
    font-weight: 600;
  }
  .who span {
    margin-left: 0.375rem;
    font-weight: 400;
    color: var(--dq-faint);
  }
  .initials {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--dq-subtle);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--dq-muted);
  }
  .timeline {
    position: relative;
    display: grid;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--dq-line);
  }
  .track {
    display: grid;
    gap: 0.375rem;
  }
  .track-label {
    font-size: 0.75rem;
    color: var(--dq-muted);
  }
  .track-bar {
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--dq-subtle);
  }
  .track-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: var(--dq-line-2);
  }
  .ticks {
    display: flex;
    justify-content: space-between;
    font: 0.6875rem/1 var(--dq-font-mono);
    color: var(--dq-faint);
  }
  .playhead {
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 0;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background: var(--dq-ink);
    opacity: 0;
    pointer-events: none;
  }
  @media (max-width: 56rem) {
    .handoff {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
