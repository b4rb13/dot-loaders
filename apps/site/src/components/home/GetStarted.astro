---
/** Three steps from install to a page that settles into place. */
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

const react = `import { LoadingRegion, SkeletonText } from '@dotquilt/react';

export function Summary({ data }: { data: Revenue | null }) {
  return (
    <LoadingRegion
      aria-label="Revenue"
      state={data ? 'ready' : 'pending'}
      placeholder={<SkeletonText lines={3} />}
    >
      {data && <RevenueCard data={data} />}
    </LoadingRegion>
  );
}`;
const native = `<dotquilt-region state="pending" aria-label="Revenue">
  <dotquilt-skeleton-text slot="placeholder" lines="3"></dotquilt-skeleton-text>
  <article>…</article>
</dotquilt-region>

<script type="module">
  import { registerLoadingRegion } from 'dotquilt/region';
  import { registerSkeletonText } from 'dotquilt/skeleton';
  registerLoadingRegion();
  registerSkeletonText();

  const region = document.querySelector('dotquilt-region');
  const data = await fetch('/api/revenue').then((r) => r.json());
  // …fill in your content, then:
  region.update({ state: 'ready' });
</script>`;
---

<section class="home-section not-content start" aria-labelledby="start-title">
  <div class="steps">
    <h2 id="start-title">A calmer page in three steps.</h2>
    <ol>
      <li><span><strong>Install</strong> the React adapter, or the core package on its own.</span></li>
      <li><span><strong>Wrap your content</strong> in a loading region, with a placeholder in its shape.</span></li>
      <li><span><strong>Set the state</strong> when your data arrives. The region does the rest.</span></li>
    </ol>
    <a class="home-button" href="/docs/installation/">Read the installation guide</a>
  </div>
  <div class="code">
    <Tabs syncKey="framework">
      <TabItem label="React">
        <Code code={react} lang="tsx" title="Summary.tsx" />
      </TabItem>
      <TabItem label="Native">
        <Code code={native} lang="html" title="index.html" />
      </TabItem>
    </Tabs>
  </div>
</section>

<style>
  .start {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  ol {
    display: grid;
    gap: 1rem;
    margin: 1.75rem 0 2rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.75rem;
    color: var(--dq-muted);
    line-height: 1.6;
  }
  li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--dq-line-2);
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--dq-ink);
  }
  li strong {
    color: var(--dq-ink);
    font-weight: 600;
  }
  .code {
    min-width: 0;
  }
  @media (max-width: 56rem) {
    .start {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
