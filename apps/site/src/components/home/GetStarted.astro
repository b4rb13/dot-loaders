---
/**
 * Three steps from install to a page that settles into place. As the section
 * arrives, the steps hand over from skeleton rows of their own shape. Below
 * them, the setup prompt for a coding assistant, one click to copy.
 */
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';
import CopyPrompt from '../site/CopyPrompt.astro';

const react = `import { LoadingRegion, SkeletonText } from '@dotquilt/react';

export function Summary({ data }: { data: Revenue | null }) {
  return (
    <LoadingRegion
      aria-label="Revenue"
      state={data ? 'ready' : 'pending'}
      placeholder={<SkeletonText lines={3} />}
    >
      {data && <RevenueCard data={data} />}
    </LoadingRegion>
  );
}`;
const vue = `<script setup lang="ts">
import { LoadingRegion, SkeletonText } from '@dotquilt/vue';

defineProps<{ data: Revenue | null }>();
</script>

<template>
  <LoadingRegion aria-label="Revenue" :state="data ? 'ready' : 'pending'">
    <template #placeholder>
      <SkeletonText :lines="3" />
    </template>
    <RevenueCard v-if="data" :data="data" />
  </LoadingRegion>
</template>`;
const svelte = `<script lang="ts">
  import { LoadingRegion, SkeletonText } from '@dotquilt/svelte';

  let { data }: { data: Revenue | null } = $props();
</script>

<LoadingRegion aria-label="Revenue" state={data ? 'ready' : 'pending'}>
  {#snippet placeholder()}
    <SkeletonText lines={3} />
  {/snippet}
  {#if data}
    <RevenueCard {data} />
  {/if}
</LoadingRegion>`;
const angular = `import { Component, input } from '@angular/core';
import { DotquiltPlaceholder, LoadingRegion, SkeletonText } from '@dotquilt/angular';

@Component({
  selector: 'app-summary',
  imports: [DotquiltPlaceholder, LoadingRegion, SkeletonText, RevenueCard],
  template: \`
    <dotquilt-region aria-label="Revenue" [state]="data() ? 'ready' : 'pending'">
      <div dotquiltPlaceholder><dotquilt-skeleton-text [lines]="3" /></div>
      @if (data(); as revenue) {
        <app-revenue-card [data]="revenue" />
      }
    </dotquilt-region>
  \`,
})
export class Summary {
  readonly data = input<Revenue | null>(null);
}`;
const native = `<dotquilt-region state="pending" aria-label="Revenue">
  <dotquilt-skeleton-text slot="placeholder" lines="3"></dotquilt-skeleton-text>
  <article>…</article>
</dotquilt-region>

<script type="module">
  import { registerLoadingRegion } from 'dotquilt/region';
  import { registerSkeletonText } from 'dotquilt/skeleton';
  registerLoadingRegion();
  registerSkeletonText();

  const region = document.querySelector('dotquilt-region');
  const data = await fetch('/api/revenue').then((r) => r.json());
  // …fill in your content, then:
  region.update({ state: 'ready' });
</script>`;
---

<section class="vc home-section not-content vc-start" aria-labelledby="vc-start-title">
  <div class="steps">
    <h2 id="vc-start-title">A calmer page in three steps.</h2>
    <dotquilt-region
      class="steps-region"
      state="ready"
      aria-label="Three steps"
      data-vc-pending
      data-steps
    >
      <div slot="placeholder" class="ph">
        {
          [70, 82, 76].map((width) => (
            <div class="ph-step">
              <dotquilt-skeleton-circle />
              <div class="ph-lines">
                <dotquilt-skeleton-line />
                <dotquilt-skeleton-line style={`width: ${width}%`} />
              </div>
            </div>
          ))
        }
      </div>
      <ol>
        <li><span><strong>Install</strong> the package for React, Vue, Svelte or Angular, or the core package on its own.</span></li>
        <li><span><strong>Wrap your content</strong> in a loading region, with a placeholder in its shape.</span></li>
        <li>
          <span>
            <strong>Set the state</strong> when your data arrives. The region does
            the rest, the way it did each time you let go above.
          </span>
        </li>
      </ol>
    </dotquilt-region>
    <a class="home-button" href="/docs/installation/">Read the installation guide</a>
    <div class="assistant">
      <p>
        <strong>Or let your coding assistant do it.</strong> One prompt reads
        your project, asks a few questions, then adds Dotquilt one place at a
        time and checks its work.
      </p>
      <div class="assistant-actions">
        <CopyPrompt />
        <a href="/docs/ai-setup/">What it does</a>
      </div>
    </div>
  </div>
  <div class="code">
    <Tabs syncKey="framework">
      <TabItem label="React">
        <Code code={react} lang="tsx" title="Summary.tsx" />
      </TabItem>
      <TabItem label="Vue">
        <Code code={vue} lang="vue" title="Summary.vue" />
      </TabItem>
      <TabItem label="Svelte">
        <Code code={svelte} lang="svelte" title="Summary.svelte" />
      </TabItem>
      <TabItem label="Angular">
        <Code code={angular} lang="ts" title="summary.ts" />
      </TabItem>
      <TabItem label="HTML">
        <Code code={native} lang="html" title="index.html" />
      </TabItem>
    </Tabs>
  </div>
</section>

<script>
  import { type LoadingRegion, registerLoadingRegion } from 'dotquilt/region';
  import {
    registerSkeletonCircle,
    registerSkeletonLine,
    registerSkeletonText,
  } from 'dotquilt/skeleton';
  import { handoffMs, onFirstView, reducedMotion, whenNear } from './hold';

  const steps = document.querySelector<LoadingRegion>('[data-steps]');
  if (steps)
    whenNear(steps, () => {
      registerSkeletonLine();
      registerSkeletonCircle();
      registerSkeletonText();
      registerLoadingRegion();
      if (reducedMotion()) return;
      onFirstView(
        steps,
        () => {
          steps.update({ state: 'pending', cycle: 'steps' });
          window.setTimeout(() => {
            if (steps.cycle === 'steps')
              steps.update({ state: 'ready', timing: { duration: handoffMs() } });
          }, 1100);
        },
        0.5,
      );
    });
</script>

<style>
  .vc-start {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .steps-region {
    margin: 1.75rem 0 2rem;
  }
  .ph {
    display: grid;
    gap: 1rem;
  }
  .ph-step {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
  }
  .ph-step dotquilt-skeleton-circle {
    width: 1.75rem;
  }
  .ph-lines {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.125rem;
  }
  ol {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    color: var(--dq-muted);
    line-height: 1.6;
  }
  li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--dq-line-2);
    border-radius: 50%;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--dq-ink);
  }
  li strong {
    color: var(--dq-ink);
    font-weight: 600;
  }
  .code {
    min-width: 0;
  }
  /* The setup prompt: a quiet second way in, under the guide link. */
  .assistant {
    display: grid;
    gap: 0.875rem;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--dq-line);
  }
  .assistant p {
    margin: 0;
    max-width: 30rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--dq-muted);
  }
  .assistant strong {
    font-weight: 600;
    color: var(--dq-ink);
  }
  .assistant-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .assistant-actions a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--dq-accent);
    text-underline-offset: 3px;
  }
  @media (max-width: 56rem) {
    .vc-start {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  /* Phones: the guide link, the code tabs and the copy button are full
     44 px targets. */
  @media (max-width: 40rem) {
    .steps .home-button,
    .assistant :global(.home-button) {
      height: 44px;
    }
    .code :global([role='tab']) {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
    .code :global(.copy button) {
      width: 44px;
      height: 44px;
    }
  }
</style>
