---
/**
 * Starlight's Hero, overridden. The homepage gets its first screen
 * (FieldHero); other pages with a hero, such as Pricing, get a centred
 * headline only.
 */
import FieldHero from './FieldHero.astro';

const { title = '', tagline } =
  Astro.locals.starlightRoute.entry.data.hero ?? {};
const home = Astro.url.pathname === '/';
---

{
  home ? (
    <FieldHero title={title} tagline={tagline} />
  ) : (
    <section class="page-hero not-content">
      <h1 id="_top" data-page-title>
        {title}
      </h1>
      {tagline && <p class="lead">{tagline}</p>}
    </section>
  )
}

<style>
  .page-hero {
    max-width: 44rem;
    margin: 0 auto;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 1rem;
    text-align: center;
  }
  .page-hero h1 {
    margin: 0;
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--dq-ink);
  }
  .lead {
    margin: 1.25rem auto 0;
    font-size: 1.09375rem;
    line-height: 1.65;
    color: var(--dq-muted);
    max-width: 40rem;
  }
</style>
