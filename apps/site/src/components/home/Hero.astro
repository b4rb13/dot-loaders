---
/**
 * Starlight's Hero, overridden. The homepage gets its first screen
 * (FieldHero); the preview-only home variants (/variants/a/ … /c/) get
 * their own first screen and a switcher between them; other pages with a
 * hero, such as Pricing, get a centred headline only.
 */
import VariantA from '../variants/a/Hero.astro';
import VariantB from '../variants/b/Hero.astro';
import VariantC from '../variants/c/Hero.astro';
import Switcher from '../variants/Switcher.astro';
import FieldHero from './FieldHero.astro';

const { title = '', tagline } =
  Astro.locals.starlightRoute.entry.data.hero ?? {};
const home = Astro.url.pathname === '/';
const variants = { a: VariantA, b: VariantB, c: VariantC } as const;
const key = /^\/variants\/([abc])\/?$/.exec(Astro.url.pathname)?.[1] as
  | keyof typeof variants
  | undefined;
const Variant = key && variants[key];
---

{
  home ? (
    <FieldHero title={title} tagline={tagline} />
  ) : Variant && key ? (
    <>
      <Variant title={title} tagline={tagline} />
      <Switcher current={key} />
    </>
  ) : (
    <section class="page-hero not-content">
      <h1 id="_top" data-page-title>
        {title}
      </h1>
      {tagline && <p class="lead">{tagline}</p>}
    </section>
  )
}

<style>
  .page-hero {
    max-width: 44rem;
    margin: 0 auto;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 1rem;
    text-align: center;
  }
  .page-hero h1 {
    margin: 0;
    font-size: clamp(2.2rem, 4.6vw, 3.4rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--dq-ink);
  }
  .lead {
    margin: 1.25rem auto 0;
    font-size: 1.09375rem;
    line-height: 1.65;
    color: var(--dq-muted);
    max-width: 40rem;
  }
</style>
