---
// The MIT license, read from the package so the page always matches it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import license from '../../../../packages/core/LICENSE?raw';
---

<StarlightPage frontmatter={{ title: 'MIT License', description: "Dotquilt's license." }}>
  <p>
    Dotquilt, its React adapter, the docs and the examples are free and open
    source under the MIT license.
  </p>
  <pre class="license">{license}</pre>
</StarlightPage>

<style>
  .license {
    white-space: pre-wrap;
    font: 0.875rem/1.7 var(--dq-font-mono);
    padding: 1.25rem;
    border: 1px solid var(--dq-line);
    border-radius: var(--dq-radius-md);
    background: var(--dq-surface);
  }
</style>
