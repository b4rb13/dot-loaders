{
  "name": "dotquilt-react-ssr-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun styles.ts && bun build src/client.tsx --outdir public --target browser --minify --define 'process.env.NODE_ENV=\"production\"'",
    "start": "NODE_ENV=production bun server.tsx",
    "check": "tsc --noEmit"
  },
  "overrides": {
    "@dotquilt-internal/core": "file:./vendor/dotquilt-internal-core-0.0.0-m2.0.tgz"
  },
  "dependencies": {
    "@dotquilt-internal/core": "file:./vendor/dotquilt-internal-core-0.0.0-m2.0.tgz",
    "@dotquilt-internal/react": "file:./vendor/dotquilt-internal-react-0.0.0-m2.0.tgz",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
