{
  "name": "@dotquilt/website",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "bun run scripts/prepare.ts",
    "dev": "bun run prepare && next dev --hostname 127.0.0.1 --port 4210",
    "build": "bun run prepare && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4210",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@dotquilt-internal/core": "workspace:*",
    "@dotquilt-internal/react": "workspace:*",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
