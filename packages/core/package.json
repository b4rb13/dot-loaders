{
  "name": "dotquilt",
  "version": "0.1.2",
  "description": "Loading placeholders that hold the shape of your content, then hand over to it. Native Web Components.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://dotquilt.dev",
  "keywords": [
    "loading",
    "skeleton",
    "placeholder",
    "loader",
    "web-components",
    "accessibility",
    "ssr"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "customElements": "dist/custom-elements.json",
  "web-types": "dist/web-types.json",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "import": "./dist/skeleton.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "import": "./dist/region.js"
    },
    "./animations": {
      "types": "./dist/animations.d.ts",
      "import": "./dist/animations.js"
    },
    "./animations/skeleton": {
      "types": "./dist/skeleton-animations.d.ts",
      "import": "./dist/skeleton-animations.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./typing": {
      "types": "./dist/typing.d.ts",
      "import": "./dist/typing.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js"
    },
    "./animations/text": {
      "types": "./dist/text-animations.d.ts",
      "import": "./dist/text-animations.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./animations/chart": {
      "types": "./dist/chart-animations.d.ts",
      "import": "./dist/chart-animations.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./animations/table": {
      "types": "./dist/table-animations.d.ts",
      "import": "./dist/table-animations.js"
    },
    "./register-all": {
      "types": "./dist/register-all.d.ts",
      "import": "./dist/register-all.js"
    },
    "./wrapper": {
      "types": "./dist/wrapper.d.ts",
      "import": "./dist/wrapper.js"
    },
    "./styles/*.css": "./dist/*.css"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test"
  },
  "author": "Derenik Khachatryan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4rb13/dot-loaders.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/b4rb13/dot-loaders/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
