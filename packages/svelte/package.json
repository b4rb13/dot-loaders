{
  "name": "@dotquilt/svelte",
  "version": "0.2.0",
  "description": "Svelte components for Dotquilt: loading placeholders that hold the shape of your content, then hand over to it.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://dotquilt.dev",
  "keywords": [
    "svelte",
    "sveltekit",
    "loading",
    "skeleton",
    "skeleton loader",
    "placeholder",
    "loader",
    "accessibility",
    "ssr"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "svelte": "./dist/skeleton.js"
    },
    "./region": {
      "types": "./dist/region.d.ts",
      "svelte": "./dist/region.js"
    },
    "./typing": {
      "types": "./dist/typing.d.ts",
      "svelte": "./dist/typing.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "svelte": "./dist/text.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "svelte": "./dist/chart.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "svelte": "./dist/table.js"
    },
    "./styles/*.css": "./dist/*.css"
  },
  "dependencies": {
    "dotquilt": "0.2.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.3",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-svelte.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "bun test test"
  },
  "author": "Derenik Khachatryan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4rb13/dot-loaders.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
